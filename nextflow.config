
params {
    sample_id = 'BC_05'
    input_dir = "${projectDir}/data/raw"
    outdir = "${projectDir}/results"
    marker_file = "${projectDir}/assets/marker_genes.csv"

    // Quality control parameters
    min_features = 200
    max_features = 10000
    max_percent_mt = 30

    // Dimensionality reduction parameters
    n_pcs = 30

    // Clustering parameters
    findneighbors_dims = 20
    resolution = 0.5

    // UMAP parameters
    umap_dims = 20
    umap_min_dist = 0.1

    // Annotation parameters
    annotation_min_score = 0.5
    annotation_min_difference = 0.25
}

conda {
    enabled = true
}
